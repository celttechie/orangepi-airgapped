# ==============================================================================
# Orange Pi Air-Gapped Provisioner (orangepi-airgapped) Configuration
# ==============================================================================

# Orange Pi Hardware Model: orangepi5-pro, orangepi5, or orangepi3-lts
OPI_MODEL="orangepi5-pro"

# Default Target MicroSD / NVMe Storage Device (e.g. /dev/sda, /dev/mmcblk0)
# Set interactively using: make select-sd
SD_DISK=""

# Armbian Base OS Configuration
# Armbian Desktop images include RK3588 GPU/HDMI drivers, XFCE desktop, Chromium, and terminal
ARMBIAN_VERSION="24.8.1"
ARMBIAN_RELEASE="noble"
ARMBIAN_DESKTOP="xfce"

# Custom image URL override (leave blank to auto-detect based on OPI_MODEL)
# Direct Armbian image archive / release URL
ARMBIAN_IMAGE_URL=""

# Air-Gapped Kubernetes & Platform Toolchain Versions
K3S_VERSION="v1.30.4+k3s1"
KUBECTL_VERSION="v1.30.4"
HELM_VERSION="v3.15.4"
ZARF_VERSION="v0.38.3"
UDS_VERSION="v0.16.0"
K9S_VERSION="v0.32.5"

# Optional Laptop Direct Ethernet Configuration (if using tethered management)
LAPTOP_IFACE="eth0"
LAPTOP_IP="192.168.42.1"
LAPTOP_NETMASK="255.255.255.0"
TARGET_IP="192.168.42.100"

# Cluster & User Settings (NIST SP 800-53 / 800-63B Compliant)
# Generate interactively with 'make config'
CLUSTER_NAME="opi-uds-edge"
DEFAULT_USER="bjarrett"
# SHA-512 crypt password hash (generate via 'openssl passwd -6 <pass>' or 'make config')
DEFAULT_PASSWORD_HASH=""
HOSTNAME="orangepi5pro"

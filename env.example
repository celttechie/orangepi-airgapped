# ==============================================================================
# Orange Pi Air-Gapped Provisioner (orangepi-airgapped) Configuration
# ==============================================================================

# Laptop Ethernet interface connected to Orange Pi (e.g. eth0, enp0s31f6, enx...)
LAPTOP_IFACE="eth0"
LAPTOP_IP="192.168.42.1"
LAPTOP_NETMASK="255.255.255.0"
LAPTOP_SUBNET="192.168.42.0"

# Target Orange Pi Network Configuration
TARGET_IP="192.168.42.100"
DHCP_RANGE_START="192.168.42.100"
DHCP_RANGE_END="192.168.42.150"

# Orange Pi Model: orangepi-5, orangepi-5-pro, or orangepi-3-lts
OPI_MODEL="orangepi-5"

# Talos Linux Version
TALOS_VERSION="v1.7.5"
KUBERNETES_VERSION="v1.30.4"

# Target Installation Disk on Orange Pi (MicroSD is typically /dev/mmcblk0 or /dev/mmcblk1)
INSTALL_DISK="/dev/mmcblk0"

# Cluster Configuration
CLUSTER_NAME="opi-uds-edge"
CLUSTER_ENDPOINT="https://192.168.42.100:6443"
